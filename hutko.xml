<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="vmpayment" method="upgrade" version="4.0">
    <name>VMPAYMENT_HUTKO</name>
    <author>hutko Service</author>
    <authorUrl>https://hutko.org/</authorUrl>
    <license>GNU General Public License version 2 or later</license>
    <version>1.0.5</version>
    <description>VMPAYMENT_HUTKO_XML_DESCRIPTION</description>
    <files>
        <filename plugin="hutko">hutko.php</filename>
        <folder>lib</folder>
        <folder>media</folder>
        <filename>index.html</filename>
    </files>
    <languages folder="language">
        <language tag="en-GB">en-GB/plg_vmpayment_hutko.ini</language>
        <language tag="uk-UA">uk-UA/plg_vmpayment_hutko.ini</language>
    </languages>
    <vmconfig>
        <fields name="params">
            <fieldset name="payment" addfieldpath="/administrator/components/com_virtuemart/fields">
                <field name="payment_logos" type="vmfiles" label="VMPAYMENT_STANDARD_LOGOS" description="VMPAYMENT_STANDARD_LOGOS_DESC" directory="/plugins/vmpayment/hutko/media" default="hutko_symbol_red.png" hide_default="1" hide_none="0" stripext="0" exclude=".*\.(php|html|xml)" />
                <field name="merchant_id" type="text" size="20" label="VMPAYMENT_HUTKO_MERCHANT_ID" description="VMPAYMENT_HUTKO_MERCHANT_ID_DESC" required="true" />
                <field name="secret_key" type="password" size="50" label="VMPAYMENT_HUTKO_SECRET_KEY" description="VMPAYMENT_HUTKO_SECRET_KEY_DESC" required="true" />
                <field name="currency" type="list" label="VMPAYMENT_HUTKO_CURRENCY" default="UAH" required="true"><option value="UAH">UAH</option><option value="USD">USD</option><option value="EUR">EUR</option><option value="GBP">GBP</option><option value="CZK">CZK</option></field>
                <field name="status_success" type="vmorderstate" scope="com_virtuemart" default="C" label="VMPAYMENT_HUTKO_STATUS_SUCCESS" />
                <field name="status_pending" type="vmorderstate" scope="com_virtuemart" default="P" label="VMPAYMENT_HUTKO_STATUS_PENDING" />
                <field name="status_canceled" type="vmorderstate" scope="com_virtuemart" default="X" label="VMPAYMENT_HUTKO_STATUS_FAILED" />
            </fieldset>
        </fields>
    </vmconfig>
</extension>
